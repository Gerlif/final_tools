# Copy to .env next to docker-compose.yml, fill in the values, then:
#   chmod 600 .env
# Docker Compose reads this file automatically. Never commit the real .env.

# Adobe Developer Console -> your project -> OAuth Server-to-Server
FRAMEIO_CLIENT_ID=
FRAMEIO_CLIENT_SECRET=

# Only needed if the credentials can see more than one Frame.io account.
# `doctor` lists the account ids when that happens.
#FRAMEIO_ACCOUNT_ID=

# Alternative to the two above: a legacy developer token from
# https://developer.frame.io/app/tokens. Also set `auth.mode: legacy` in
# config.yaml. Only works if the account is not on Adobe Admin Console, and
# the legacy API is retired after 2026-12-01.
#FRAMEIO_LEGACY_TOKEN=
